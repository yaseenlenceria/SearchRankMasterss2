# Use Unpkg CDN as a fallback for camelcase-css
camelcase-css@2.0.1:registry=https://unpkg.com/
# Use default registry for everything else
registry=https://registry.npmjs.org/
# Allow overriding peer dependencies to resolve conflicts
legacy-peer-deps=true
# Force fetch the latest versions for safety
prefer-online=true
# Add resolution to use specific version of camelcase-css
resolution.camelcase-css=2.0.1